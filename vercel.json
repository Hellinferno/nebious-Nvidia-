{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci && npm --prefix frontend ci",
  "buildCommand": "npm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/gateway.mjs": {
      "maxDuration": 300,
      "includeFiles": "deployment/vercel/runtime-package.json"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/gateway" }
  ]
}
