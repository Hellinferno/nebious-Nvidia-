# Copy to .env at the repository root. Never commit .env.

# Nebius Token Factory (OpenAI-compatible) — server-side secret, never shipped to the browser
NEBIUS_API_KEY=your_api_key_here
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Exact model id copied from the account catalog after preflight (scripts/provider_preflight.py)
NEBIUS_MODEL_ID=

# Execution runner: mock (no isolated execution yet) or contree (after a real preflight)
BENCHPROOF_RUNNER=mock

# API server
PORT=8000
HOST=127.0.0.1
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# SQLite database file (relative to the directory you start the API/worker from)
DATABASE_PATH=benchproof.db
